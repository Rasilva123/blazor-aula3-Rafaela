@page "/produtos"

<h3 class="mb-4">Produtos</h3>

<div class="row">
    <div class="col-md-4">
        <Cartao Titulo="Cadastro de Produtos">
            <FormProduto AoSalvar="Adicionar" />
        </Cartao>
    </div>

    <div class="col-md-8">
        <Cartao Titulo="Produtos Cadastrados">
            @if (produtos.Count == 0)
            {
                <p class="text-muted">
                    Nenhum produto cadastrado.
                </p>
            }
            else
            {
                <TabelaProdutos Produtos="produtos" />
            }
        </Cartao>
    </div>
</div>

@code {
    private List<Produto> produtos = new();

    private void Adicionar(Produto produto)
    {
        produtos.Add(produto);
    }
}