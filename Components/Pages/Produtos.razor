
@page "/produtos"
@using Microsoft.EntityFrameworkCore
@using SistemaEstoque.Data
@inject IDbContextFactory<AppDbContext> DbFactory

<h3 class="mb-4">Produtos</h3>

<div class="row">
    <div class="col-md-4">
        <Cartao Titulo="Cadastro de Produtos">
            <FormProduto AoSalvar="Adicionar" />
        </Cartao>
    </div>

    <div class="col-md-8">
        <Cartao Titulo="Produtos Cadastrados">
            @if (produtos.Count == 0)
            {
                <p class="text-muted">
                    Nenhum produto cadastrado.
                </p>
            }
            else
            {
                <TabelaProdutos Produtos="produtos"
                                AoExcluir="Excluir" />
            }
        </Cartao>
    </div>
</div>

@code {
    private List<Produto> produtos = new();

    protected override async Task OnInitializedAsync()
    {
        await CarregarProdutos();
    }

    private async Task CarregarProdutos()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        produtos = await db.Produtos.ToListAsync();
    }

    private async Task Adicionar(Produto produto)
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        db.Produtos.Add(produto);

        await db.SaveChangesAsync();

        await CarregarProdutos();
    }

    private async Task Excluir(Produto produto)
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        var produtoBanco = await db.Produtos.FindAsync(produto.Id);

        if (produtoBanco != null)
        {
            db.Produtos.Remove(produtoBanco);

            await db.SaveChangesAsync();
        }

        await CarregarProdutos();
    }
}
