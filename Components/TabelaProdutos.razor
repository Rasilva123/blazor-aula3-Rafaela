
<table class="table table-striped">
    <thead>
        <tr>
            <th>Nome</th>
            <th>Preço</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var p in Produtos)
        {
            <tr>
                <td>@p.Nome</td>
                <td>@p.Preco.ToString("C")</td>
            </tr>
        }
    </tbody>
</table>

@code {
    [Parameter]
    public List<Produto> Produtos { get; set; } = new();
}